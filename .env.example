# --- Paths ---
DOWNLOAD_DIR=/opt/qlvb_ai/data/downloads
STORE_DIR=/opt/qlvb_ai/data/store
CRAWLER_STATE_DB=/opt/qlvb_ai/data/store/crawler_state.sqlite3

# --- Crawler (bounded resource usage) ---
CRAWLER_BATCH_SIZE=20
CRAWLER_NAVIGATION_RETRIES=3
CRAWLER_LOGIN_RETRIES=5
CRAWLER_PAGE_TIMEOUT_SECONDS=90
CRAWLER_LOGIN_FORM_TIMEOUT_SECONDS=30
CRAWLER_LOGIN_INPUT_TIMEOUT_SECONDS=600
CRAWLER_LOGIN_RESULT_TIMEOUT_SECONDS=45
CRAWLER_ACTION_TIMEOUT_SECONDS=20
CRAWLER_DOWNLOAD_TIMEOUT_SECONDS=60
# 0 = không giới hạn số trang
CRAWLER_MAX_PAGES=0
# QLVB dùng chứng chỉ tự ký thì để true; đặt false nếu chứng chỉ hợp lệ
CRAWLER_IGNORE_HTTPS_ERRORS=true
QLVB_URL=https://egov1.laocai.gov.vn
# SSO không công bố thời hạn captcha: tự đổi mã sau số giây này; mở lại trang đăng nhập sau MAX_AGE
CRAWLER_CAPTCHA_TTL_SECONDS=180
CRAWLER_LOGIN_PAGE_MAX_AGE_SECONDS=900

# --- Crawler qua API QLVB (khuyến nghị) ---
QLVB_API_BASE_URL=https://egov-gateway.laocai.gov.vn
QLVB_STORAGE_HOSTS=egov-storage1.laocai.gov.vn,egov-storage.laocai.gov.vn
# Cỡ trang mặc định khi kiểm kê (10–500); có thể chọn lại trên trang admin
CRAWLER_API_PAGE_SIZE=100
# Nghỉ giữa các request để không gây tải cho QLVB
CRAWLER_API_DELAY_MS=300
CRAWLER_API_MAX_ATTEMPTS=5
CRAWLER_MAX_FILE_MB=100
# Văn bản có độ mật khác "Thường" không được tải/gửi sang AI
CRAWLER_SKIP_CLASSIFIED=true

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=changeme_qdrant_key
RAG_COLLECTION=docnexus_agentic_v4

# --- Postgres ---
PG_DSN=host=localhost port=5432 dbname=qlvb user=qlvb password=changeme_pg

# --- Embedding ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# auto | cuda | cpu — auto/cuda dùng GPU khi có (fp16), không có GPU thì tự dùng CPU
EMBEDDING_DEVICE=auto
RERANK_MAX_LENGTH=512
# Nạp mô hình ngay khi khởi động để câu hỏi đầu tiên không bị chậm
WARMUP_MODELS=true

# --- LLM (OpenRouter mặc định) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-...
LLM_CHEAP=google/gemini-2.5-flash-lite
LLM_MAIN=qwen/qwen-2.5-72b-instruct
LLM_SMART=google/gemini-2.5-pro
LLM_FALLBACK=google/gemini-2.5-pro
# Tính năng cần loại đầu vào riêng: gỡ băng cần model nhận âm thanh, OCR cần model nhận ảnh.
# Định dạng "nhà_cung_cấp:model" (openrouter | openai | anthropic | gemini | local); không tiền tố = OpenRouter.
# Admin có thể đổi model cho từng tính năng trên trang quản trị (tab Mô hình AI); các giá trị ở đây là mặc định.
LLM_TRANSCRIBE=gemini:gemini-2.5-flash
LLM_OCR=local:Unlimited-OCR
# Khoá gọi trực tiếp (không bắt buộc; có thể nhập trên trang quản trị, được mã hoá khi lưu)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Tỷ giá dùng để ước tính chi phí mỗi câu hỏi trên bảng giá
USD_TO_VND=26000
LLM_MAX_OUTPUT_TOKENS=4096
# Timeout cho lời gọi phụ trợ (lập kế hoạch, chấm bằng chứng, kiểm chứng)
LLM_FAST_TIMEOUT_SECONDS=20
# Stream trả lời im lặng quá ngưỡng này thì chuyển sang LLM_FALLBACK (khi chưa có token nào)
LLM_STREAM_IDLE_TIMEOUT_SECONDS=20


# --- Agentic RAG ---
AGENT_ROUTING_MODE=selective
RAG_FAST_MIN_SCORE=0.65
AGENT_MAX_ATTEMPTS=2
AGENT_TIMEOUT_SECONDS=60
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
# GPU: 32; chỉ có CPU: 8
EMBED_BATCH_SIZE=32
MODEL_CPU_THREADS=4
RAG_CONCURRENCY=2
PG_POOL_SIZE=8
QDRANT_TIMEOUT_SECONDS=10
RAG_MIN_RERANK_SCORE=0.1
RAG_MIN_EVIDENCE=2
RAG_MULTI_QUERY_COUNT=3
RAG_MAX_CHUNKS_PER_DOC=3
RAG_RERANK_POOL=24
RAG_ASPECT_MIN_SCORE=0.3
RAG_LOG_QUERIES=true
# Tệp trong cùng văn bản giống nhau từ ngưỡng này chỉ index một lần (bản ký số / DOCX)
DUPLICATE_FILE_SIMILARITY=0.8

# --- Tổng hợp số liệu (Aggregation v2) ---
AGG_MAX_DOCS=400
AGG_CHUNKS_PER_DOC=4
AGG_CONCURRENCY=4
AGG_MIN_SCORE=0.2
AGG_MIN_CONFIDENCE=0.6
AGG_TIMEOUT_SECONDS=240

# --- Tải lên / OCR ---
UPLOAD_MAX_MB=25
AUDIO_MAX_MB=60
UPLOAD_CONCURRENCY=2
OCR_SERVER_URL=http://127.0.0.1:10000
OCR_MAX_PAGES=40
OCR_PAGES_PER_REQUEST=4
OCR_DPI=200

# --- Giới hạn trích xuất ---
# Tệp/văn bản dài hơn bấy nhiêu ký tự thì cắt bớt (kèm ghi chú) thay vì làm lỗi cả lần nạp
EXTRACT_MAX_FILE_CHARS=3000000
EXTRACT_MAX_DOCUMENT_CHARS=6000000
# Bảng tính: dừng đọc sheet sau chừng này dòng trống liên tiếp; nhắc lại tên cột sau mỗi N dòng
EXCEL_EMPTY_ROW_STOP=500
EXCEL_HEADER_EVERY=20

# --- Tài khoản & quản trị ---
# Lần chạy đầu (bảng users trống) tạo tài khoản super admin từ ADMIN_USER/ADMIN_PASS.
# Mật khẩu yếu/mặc định (< 10 ký tự) thì không tạo; khi đó dùng scripts/create_user.py.
# Sau đó quản lý tài khoản trên trang /admin (tab Tài khoản); đổi ADMIN_PASS không đổi mật khẩu đã tạo.
ADMIN_USER=admin
ADMIN_PASS=
# Khoá mã hoá khoá API lưu trong database; để trống thì tự sinh vào data/app_secret.key (giữ file này khi sao lưu)
APP_SECRET_KEY=
# Thời hạn phiên đăng nhập: thường (giờ) và khi chọn "Ghi nhớ đăng nhập" (ngày)
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=30
ADMIN_MAX_FAILED_LOGINS=10
ADMIN_LOCKOUT_SECONDS=900
# true khi chạy sau Cloudflare Tunnel để khóa đúng IP người dùng
TRUST_PROXY_HEADERS=false

# --- Kiểm tra nội dung & căn cứ: CSDL quốc gia về pháp luật (vbpl.vn) ---
# Chỉ đọc sitemap và trang công khai (tuân thủ robots.txt), tuần tự, cách nhau LEGAL_FETCH_INTERVAL giây.
LEGAL_REGISTRY_ENABLED=true
LEGAL_FETCH_INTERVAL=1.0
LEGAL_FETCH_TIMEOUT=20
# Tự cập nhật danh mục văn bản sau bấy nhiêu ngày (chạy nền khi khởi động)
LEGAL_INDEX_MAX_AGE_DAYS=7
# Số văn bản quy phạm tra cứu tối đa cho mỗi dự thảo
LEGAL_MAX_LOOKUPS=25

# --- Log: ghi ra tệp trong LOG_DIR, không in ra console; tự xoay vòng và nén gzip ---
LOG_DIR=data/logs
LOG_LEVEL=INFO
# Dung lượng mỗi tệp (MB) trước khi xoay vòng, số bản cũ giữ lại cho mỗi tệp
LOG_MAX_MB=20
LOG_BACKUPS=5
# Ghi access.log (mỗi request HTTP một dòng)
LOG_ACCESS=true
# true: in thêm log ra console (khi gỡ lỗi)
LOG_CONSOLE=false
