# --- Paths ---
DOWNLOAD_DIR=/opt/qlvb_ai/data/downloads
STORE_DIR=/opt/qlvb_ai/data/store
CRAWLER_STATE_DB=/opt/qlvb_ai/data/store/crawler_state.sqlite3

# --- Crawler (bounded resource usage) ---
CRAWLER_BATCH_SIZE=20
CRAWLER_NAVIGATION_RETRIES=3
CRAWLER_LOGIN_RETRIES=5
CRAWLER_PAGE_TIMEOUT_SECONDS=90
CRAWLER_LOGIN_FORM_TIMEOUT_SECONDS=30
CRAWLER_LOGIN_INPUT_TIMEOUT_SECONDS=600
CRAWLER_LOGIN_RESULT_TIMEOUT_SECONDS=45
CRAWLER_ACTION_TIMEOUT_SECONDS=20
CRAWLER_DOWNLOAD_TIMEOUT_SECONDS=60
# 0 = không giới hạn số trang
CRAWLER_MAX_PAGES=0
# QLVB dùng chứng chỉ tự ký thì để true; đặt false nếu chứng chỉ hợp lệ
CRAWLER_IGNORE_HTTPS_ERRORS=true

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=changeme_qdrant_key
RAG_COLLECTION=docnexus_agentic_v4

# --- Postgres ---
PG_DSN=host=localhost port=5432 dbname=qlvb user=qlvb password=changeme_pg

# --- Embedding ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu
RERANK_MAX_LENGTH=512
# Nạp mô hình ngay khi khởi động để câu hỏi đầu tiên không bị chậm
WARMUP_MODELS=true

# --- LLM (OpenRouter mặc định) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-...
LLM_CHEAP=google/gemini-2.5-flash-lite
LLM_MAIN=qwen/qwen-2.5-72b-instruct
LLM_SMART=google/gemini-2.5-pro
LLM_FALLBACK=google/gemini-2.5-pro
LLM_MAX_OUTPUT_TOKENS=4096
# Timeout cho lời gọi phụ trợ (lập kế hoạch, chấm bằng chứng, kiểm chứng)
LLM_FAST_TIMEOUT_SECONDS=20
# Stream trả lời im lặng quá ngưỡng này thì chuyển sang LLM_FALLBACK (khi chưa có token nào)
LLM_STREAM_IDLE_TIMEOUT_SECONDS=20


# --- Agentic RAG ---
AGENT_ROUTING_MODE=selective
RAG_FAST_MIN_SCORE=0.65
AGENT_MAX_ATTEMPTS=2
AGENT_TIMEOUT_SECONDS=60
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
EMBED_BATCH_SIZE=8
MODEL_CPU_THREADS=4
RAG_CONCURRENCY=2
PG_POOL_SIZE=8
QDRANT_TIMEOUT_SECONDS=10
RAG_MIN_RERANK_SCORE=0.1
RAG_MIN_EVIDENCE=2
RAG_MULTI_QUERY_COUNT=3
RAG_MAX_CHUNKS_PER_DOC=3
RAG_RERANK_POOL=24
RAG_ASPECT_MIN_SCORE=0.3
RAG_LOG_QUERIES=true
# Tệp trong cùng văn bản giống nhau từ ngưỡng này chỉ index một lần (bản ký số / DOCX)
DUPLICATE_FILE_SIMILARITY=0.8

# --- Tổng hợp số liệu (Aggregation v2) ---
AGG_MAX_DOCS=400
AGG_CHUNKS_PER_DOC=4
AGG_CONCURRENCY=4
AGG_MIN_SCORE=0.2
AGG_MIN_CONFIDENCE=0.6
AGG_TIMEOUT_SECONDS=240

# --- Tải lên / OCR ---
UPLOAD_MAX_MB=25
AUDIO_MAX_MB=60
UPLOAD_CONCURRENCY=2
OCR_SERVER_URL=http://127.0.0.1:10000
OCR_MAX_PAGES=40
OCR_PAGES_PER_REQUEST=4
OCR_DPI=200

# --- Quản trị ---
# Bắt buộc đổi: mật khẩu yếu/mặc định (< 10 ký tự) sẽ khóa trang /admin
ADMIN_USER=admin
ADMIN_PASS=
ADMIN_MAX_FAILED_LOGINS=10
ADMIN_LOCKOUT_SECONDS=900
# true khi chạy sau Cloudflare Tunnel để khóa đúng IP người dùng
TRUST_PROXY_HEADERS=false
